# .env.example
# ------------------------------------------------------------------------------
# Environment Variables for Interest Group Analysis Pipeline
# Copy this file to `.env` and replace placeholders with your actual credentials.
# NEVER commit the real `.env` file to version control.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# API KEYS
# ------------------------------------------------------------------------------

# GovInfo API (Congressional Record downloads)
# Get your key at: https://api.data.gov/signup/
GOVINFO_API_KEY=REPLACE_WITH_YOUR_GOVINFO_API_KEY

# Congress.gov API (Bills, Members metadata)
# Get your key at: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=REPLACE_WITH_YOUR_CONGRESS_API_KEY

# ------------------------------------------------------------------------------
# PIPELINE CONFIGURATION
# ------------------------------------------------------------------------------

# Number of parallel workers for data processing
NUM_WORKERS=4

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# OPTIONAL: DATA PATHS
# ------------------------------------------------------------------------------
# Uncomment to override default paths (relative to project root)
# DATA_DIR=./data
# OUTPUT_DIR=./outputs

# ------------------------------------------------------------------------------
# OPTIONAL: GOOGLE TRENDS PROXY
# ------------------------------------------------------------------------------
# pytrends doesn't require an API key but may be rate-limited
# Use a proxy for high-volume collection
# GOOGLE_PROXY=http://your-proxy-server:port
