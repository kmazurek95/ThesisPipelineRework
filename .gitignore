# -----------------------------
# Virtual environments
# -----------------------------
.venv/
venv/
env/
ENV/

# -----------------------------
# Python bytecode / caches
# -----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pyright/
.cache/
.ipynb_checkpoints/

# -----------------------------
# Build / packaging
# -----------------------------
build/
dist/
*.egg-info/
.eggs/

# -----------------------------
# Editors / OS junk
# -----------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# -----------------------------
# Environment & secrets
# (keep the example file tracked)
# -----------------------------
.env
*.env
!.env.example

# Ignore the real .env file
.env

# -----------------------------
# Logs / debug scratch
# -----------------------------
*.log
debug_output.txt

# -----------------------------
# Data
# - Ignore big/derived data
# - Keep docs and sample fixtures
# -----------------------------
data/raw/
data/processed/
data/normalized/

# Ignore common data files at the top of data/
data/*.csv
data/*.xlsx
data/*.json
data/*.sqlite3
data/*.jsonl

# Ignore common normalized artifacts recursively
data/**/by_package/
data/**/granules_core.csv
data/**/granule_members.csv
data/**/granule_committees.csv
data/**/granule_references.csv
data/**/package_meta.json

# QA HTML snapshots
qa_*.html

# Keep these explicitly
!data/.gitkeep
!data/README.md
!data/sample/**
# (add more explicit allowlists under data/sample if needed)

# -----------------------------
# Results
# - Ignore outputs; keep folder markers/docs
# -----------------------------
results/**
!results/.gitkeep
!results/README.md

# -----------------------------
# Classifier artifacts
# -----------------------------
results_classifier/
*.joblib

# -----------------------------
# Intermediate/processed data
# - Large files generated by pipeline
# -----------------------------
data/intermediate/
data/MergedData/
data/labeling/

# -----------------------------
# R cache
# -----------------------------
R_analysis/Multilevel_Analysis_cache/

# -----------------------------
# Output data for dashboard
# - Track essential files for Streamlit deployment
# - Ignore very large files (>100MB)
# - level1.csv.gz (14MB) is tracked; uncompressed level1.csv (114MB) is ignored
# -----------------------------
data/output/multi_level_data.csv
data/output/level1.csv
data/output/data_legacy_thesis.txt
data/output/analysis_dataset_replication.csv

# -----------------------------
# Output figures and tables
# - Track these to showcase results
# -----------------------------
# outputs/  # Uncomment to ignore outputs

# -----------------------------
# Notebooks
# - Keep showcase notebook tracked
# -----------------------------
# *.ipynb  # Don't ignore - we want to track the showcase notebook
.ipynb_checkpoints/

# -----------------------------
# Cloud / CI local artifacts
# -----------------------------
.azure/

# -----------------------------
# Generator scripts (scaffolding artifacts)
# -----------------------------
_gen_*.py

# -----------------------------
# Workspace files
# -----------------------------
*.code-workspace

# results_replication/ is tracked (thesis replication outputs)

# -----------------------------
# R cache (replication)
# -----------------------------
R_analysis/cache/

# -----------------------------
# Archive folder (legacy/obsolete files)
# -----------------------------
archive/
